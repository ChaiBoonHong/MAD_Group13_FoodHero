<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_add_edit_listing"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_add_edit_listing"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorSurface"
        android:elevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/add_listing_title"
        app:titleTextColor="@color/colorTextPrimary" />

    <!-- Form ScrollView -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_form"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_action"
        app:layout_constraintTop_toBottomOf="@id/toolbar_add_edit_listing">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_16"
            android:paddingTop="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_24">

            <!-- SECTION 1: PHOTO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_photo"
                android:textColor="@color/colorTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Choose upload to Supabase Storage or external HTTPS photo URL to save storage quota."
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp" />

            <!-- Photo Source Toggle Tabs -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_photo_source"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="@dimen/spacing_12"
                android:background="@drawable/bg_pill_chip_inactive"
                app:tabIndicatorColor="@color/colorPrimary"
                app:tabIndicatorHeight="3dp"
                app:tabMode="fixed"
                app:tabSelectedTextColor="@color/colorPrimary"
                app:tabTextColor="@color/colorTextSecondary">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/upload_photo_tab" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/use_url_tab" />
            </com.google.android.material.tabs.TabLayout>

            <!-- Container for Device Upload Mode -->
            <LinearLayout
                android:id="@+id/layout_upload_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_10"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_choose_device_photo"
                    style="@style/Widget.FoodHero.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/btn_choose_photo"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_photo_camera"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <!-- Container for External URL Mode -->
            <LinearLayout
                android:id="@+id/layout_url_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_10"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_photo_url"
                    style="@style/Widget.FoodHero.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/photo_url_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_photo_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_preview_url"
                    style="@style/Widget.FoodHero.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="@dimen/spacing_6"
                    android:text="@string/btn_preview_url"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_link"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <!-- Image Preview Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FoodHero.Card"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="@dimen/spacing_10"
                app:cardCornerRadius="16dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/iv_listing_photo_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Photo Preview"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_food_placeholder" />

                    <ProgressBar
                        android:id="@+id/progress_photo_upload"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/colorPrimary"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_photo_source_label"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="@dimen/spacing_8"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="@color/scrim_dark"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/spacing_8"
                        android:text="Source: Default Placeholder"
                        android:textColor="@color/white"
                        android:textSize="11sp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 2: FOOD DETAILS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:text="@string/section_food_details"
                android:textColor="@color/colorTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_listing_title"
                style="@style/Widget.FoodHero.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:hint="@string/listing_title_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_listing_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_listing_description"
                style="@style/Widget.FoodHero.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:hint="@string/listing_desc_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_listing_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:lines="3"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_10"
                android:text="Food Category"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp" />

            <!-- Category Single Selection Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_cat_meals"
                        style="@style/Widget.FoodHero.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Meals" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_cat_bakery"
                        style="@style/Widget.FoodHero.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bakery" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_cat_veg"
                        style="@style/Widget.FoodHero.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vegetarian" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_cat_halal"
                        style="@style/Widget.FoodHero.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Halal" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_cat_beverages"
                        style="@style/Widget.FoodHero.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Beverages" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_cat_groceries"
                        style="@style/Widget.FoodHero.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Groceries" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- SECTION 3: PRICE & INVENTORY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:text="@string/section_price_stock"
                android:textColor="@color/colorTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_original_price"
                    style="@style/Widget.FoodHero.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_6"
                    android:layout_weight="1"
                    android:hint="@string/original_price_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_original_price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Discounted Price (RM10 ceiling strictly enforced!) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_discounted_price"
                    style="@style/Widget.FoodHero.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_6"
                    android:layout_weight="1"
                    android:hint="@string/discount_price_hint"
                    app:errorEnabled="true"
                    app:helperText="Max RM10.00 ceiling"
                    app:helperTextEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_discounted_price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_quantity"
                    style="@style/Widget.FoodHero.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_6"
                    android:layout_weight="1"
                    android:hint="@string/quantity_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_quantity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1"
                        android:text="4"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_co2"
                    style="@style/Widget.FoodHero.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_6"
                    android:layout_weight="1"
                    android:hint="@string/co2_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_co2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:text="1.50"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- SECTION 4: PICKUP WINDOW -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:text="@string/section_pickup"
                android:textColor="@color/colorTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_pickup_start"
                    style="@style/Widget.FoodHero.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_6"
                    android:layout_weight="1"
                    android:hint="@string/pickup_start_hint"
                    app:startIconDrawable="@drawable/ic_clock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_pickup_start"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:text="16:30"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_pickup_end"
                    style="@style/Widget.FoodHero.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_6"
                    android:layout_weight="1"
                    android:hint="@string/pickup_end_hint"
                    app:startIconDrawable="@drawable/ic_clock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_pickup_end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:text="18:00"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- SECTION 5: CAMPUS LOCATION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:text="@string/section_location"
                android:textColor="@color/colorTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_select_landmark"
                style="@style/Widget.FoodHero.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_14">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Landmark"
                        android:src="@drawable/ic_location"
                        app:tint="@color/colorPrimary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_selected_landmark_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Student Pavilion I (Cafeteria)"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_selected_landmark_coords"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UTAR Kampar On-Campus Boundary Validated"
                            android:textColor="@color/colorSuccess"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Dropdown"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/colorTextSecondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Sticky Action -->
    <FrameLayout
        android:id="@+id/layout_bottom_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        android:elevation="8dp"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_12"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit_listing"
            style="@style/Widget.FoodHero.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/btn_publish_listing"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/progress_submitting"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/white"
            android:visibility="gone" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
