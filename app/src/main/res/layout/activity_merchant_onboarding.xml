<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_merchant_onboarding"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_onboarding_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_slab"
                android:text="Complete Merchant Setup"
                android:textColor="@color/colorTextPrimary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_onboarding_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/colorTextPrimary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_onboarding_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Step 1 of 3 · Business details"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_onboarding_steps"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:max="3"
            android:progress="1"
            app:indicatorColor="@color/colorPrimary"
            app:trackColor="@color/colorPrimaryContainer" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/step_onboarding_business"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FoodHero.Card.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_slab" android:text="Tell us about your stall"
                        android:textColor="@color/colorTextPrimary" android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="Students will see these details before placing an order."
                        android:textColor="@color/colorTextSecondary" android:textSize="13sp" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_onboarding_business"
                        style="@style/Widget.FoodHero.TextInputLayout" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="Business name">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_onboarding_business"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_onboarding_description"
                        style="@style/Widget.FoodHero.TextInputLayout" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Stall description"
                        app:counterEnabled="true" app:counterMaxLength="240">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_onboarding_description"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top"
                            android:inputType="textCapSentences|textMultiLine" android:minLines="3" android:maxLength="240" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_onboarding_phone"
                        style="@style/Widget.FoodHero.TextInputLayout" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Contact phone">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_onboarding_phone"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/step_onboarding_payment"
            android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
            android:visibility="gone">
            <com.google.android.material.card.MaterialCardView style="@style/Widget.FoodHero.Card.Large"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="20dp" android:layout_marginTop="8dp" android:layout_marginEnd="20dp" android:layout_marginBottom="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_slab" android:text="Connect DuitNow"
                        android:textColor="@color/colorTextPrimary" android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="Upload the real QR students should use for payment."
                        android:textColor="@color/colorTextSecondary" android:textSize="13sp" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_onboarding_duitnow_name"
                        style="@style/Widget.FoodHero.TextInputLayout" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="DuitNow account/display name">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_onboarding_duitnow_name"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.card.MaterialCardView style="@style/Widget.FoodHero.Card"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center_horizontal" android:orientation="vertical" android:padding="16dp">
                            <ImageView android:id="@+id/iv_onboarding_qr" android:layout_width="152dp" android:layout_height="152dp"
                                android:contentDescription="Selected DuitNow QR" android:scaleType="centerCrop" android:visibility="gone" />
                            <TextView android:id="@+id/tv_onboarding_qr_status" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:gravity="center"
                                android:text="No QR selected\nJPEG, PNG or WebP · maximum 5 MB"
                                android:textColor="@color/colorTextSecondary" android:textSize="13sp" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="12dp" android:gravity="center" android:orientation="horizontal">
                                <com.google.android.material.button.MaterialButton android:id="@+id/btn_choose_duitnow_qr"
                                    style="@style/Widget.FoodHero.Button.Secondary" android:layout_width="wrap_content"
                                    android:layout_height="48dp" android:text="Choose QR" />
                                <com.google.android.material.button.MaterialButton android:id="@+id/btn_remove_duitnow_qr"
                                    style="@style/Widget.FoodHero.Button.Text" android:layout_width="wrap_content"
                                    android:layout_height="48dp" android:layout_marginStart="8dp" android:text="Remove"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.NestedScrollView android:id="@+id/step_onboarding_location"
            android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="8dp"
                android:paddingEnd="20dp" android:paddingBottom="24dp">
                <com.google.android.material.card.MaterialCardView style="@style/Widget.FoodHero.Card.Large"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="20dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_slab" android:text="Pin your pickup point"
                            android:textColor="@color/colorTextPrimary" android:textSize="20sp" android:textStyle="bold" />
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_onboarding_campus"
                            style="@style/Widget.FoodHero.TextInputLayout" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="Campus"
                            app:endIconMode="dropdown_menu">
                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/dropdown_onboarding_campus" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_onboarding_landmark"
                            style="@style/Widget.FoodHero.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="Pickup landmark"
                            app:endIconMode="dropdown_menu">
                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/dropdown_onboarding_landmark"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <FrameLayout android:layout_width="match_parent" android:layout_height="300dp" android:layout_marginTop="12dp">
                            <com.google.android.gms.maps.MapView android:id="@+id/map_onboarding_location"
                                android:layout_width="match_parent" android:layout_height="match_parent" />
                        </FrameLayout>
                        <TextView android:id="@+id/tv_onboarding_pin" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="12dp"
                            android:text="Select a Supabase-defined campus pickup landmark."
                            android:textColor="@color/colorTextSecondary" android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView style="@style/Widget.FoodHero.Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Review" android:textColor="@color/colorTextPrimary" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_onboarding_review" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="8dp"
                            android:textColor="@color/colorTextSecondary" android:textSize="13sp" />
                        <CheckBox android:id="@+id/check_onboarding_terms" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="8dp"
                            android:text="I confirm the business, payment, food-safety and pickup details are accurate." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/colorSurface" android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="20dp" android:paddingTop="12dp" android:paddingEnd="20dp" android:paddingBottom="16dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_onboarding_back"
            style="@style/Widget.FoodHero.Button.Secondary" android:layout_width="104dp"
            android:layout_height="48dp" android:text="Back" android:visibility="invisible" />
        <Space android:layout_width="12dp" android:layout_height="1dp" />
        <ProgressBar android:id="@+id/progress_onboarding" android:layout_width="32dp" android:layout_height="32dp"
            android:layout_marginEnd="12dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_complete_onboarding"
            style="@style/Widget.FoodHero.Button.Primary" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="48dp" android:minWidth="0dp"
            android:maxLines="1" android:text="Continue" />
    </LinearLayout>
</LinearLayout>
