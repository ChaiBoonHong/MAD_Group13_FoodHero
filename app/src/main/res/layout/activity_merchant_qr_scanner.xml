<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_qr_scanner"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_scanner"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/scrim_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/white"
        app:title="@string/qr_scanner_title"
        app:titleTextColor="@color/white" />

    <!-- ZXing Decorated Barcode View -->
    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/barcode_scanner_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/layout_scanner_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_scanner" />

    <!-- Torch Toggle Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_toggle_torch"
        style="@style/Widget.FoodHero.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        android:backgroundTint="@color/scrim_dark"
        android:text="Torch: Off"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_scanner"
        app:strokeColor="@color/white" />

    <!-- Camera Permission Fallback Container -->
    <LinearLayout
        android:id="@+id/layout_permission_denied"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/colorPrimaryDark"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_32"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layout_scanner_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_scanner">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Camera Permission"
            android:src="@drawable/ic_photo_camera"
            app:tint="@color/colorAccent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:gravity="center"
            android:text="Camera Permission Required"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:gravity="center"
            android:text="To scan student QR pickup codes, allow camera access. Alternatively, enter the manual pickup code below."
            android:textColor="#CFD8DC"
            android:textSize="@dimen/text_size_sub" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_grant_camera"
            style="@style/Widget.FoodHero.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/spacing_20"
            android:text="Grant Permission" />
    </LinearLayout>

    <!-- Bottom Controls -->
    <LinearLayout
        android:id="@+id/layout_scanner_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_16"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/qr_scanner_hint"
            android:textColor="@color/colorTextSecondary"
            android:textSize="@dimen/text_size_caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_enter_manual_code"
            style="@style/Widget.FoodHero.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/spacing_10"
            android:text="Enter Order Code Manually"
            android:textSize="14sp"
            app:icon="@drawable/ic_qr_code"
            app:iconGravity="textStart" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
