<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_student_role_signup"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/colorBackground" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="16dp"
        android:paddingEnd="20dp" android:paddingBottom="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_slab" android:text="Sign up as Student"
            android:textColor="@color/colorTextPrimary" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_student_signup_step" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="Step 1 of 3 · Student details" android:textColor="@color/colorTextSecondary" android:textSize="13sp" />
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_student_signup_steps" android:layout_width="match_parent"
            android:layout_height="4dp" android:layout_marginTop="12dp" android:max="3" android:progress="1"
            app:indicatorColor="@color/colorPrimary" app:trackColor="@color/colorPrimaryContainer" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.core.widget.NestedScrollView android:id="@+id/step_student_details"
            android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <com.google.android.material.card.MaterialCardView style="@style/Widget.FoodHero.Card.Large"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="20dp" android:layout_marginTop="8dp" android:layout_marginEnd="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_slab" android:text="Verify your university identity"
                        android:textColor="@color/colorTextPrimary" android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="Use a supported institutional email. This adds Student access to your current account."
                        android:textColor="@color/colorTextSecondary" android:textSize="13sp" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_student_signup_email"
                        style="@style/Widget.FoodHero.TextInputLayout" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="Institutional email">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_student_signup_email"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_student_signup_id"
                        style="@style/Widget.FoodHero.TextInputLayout" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Student ID">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_student_signup_id"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapCharacters" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_student_signup_faculty"
                        style="@style/Widget.FoodHero.TextInputLayout" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Faculty">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_student_signup_faculty"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.core.widget.NestedScrollView>
        <androidx.core.widget.NestedScrollView android:id="@+id/step_student_code"
            android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
            <com.google.android.material.card.MaterialCardView style="@style/Widget.FoodHero.Card.Large"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="20dp" android:layout_marginTop="8dp" android:layout_marginEnd="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_slab" android:text="Enter the 6-digit code"
                        android:textColor="@color/colorTextPrimary" android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_student_code_destination" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:textColor="@color/colorTextSecondary" android:textSize="13sp" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_student_signup_code"
                        style="@style/Widget.FoodHero.TextInputLayout" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="Verification code">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_student_signup_code"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:digits="0123456789"
                            android:inputType="number" android:maxLength="6" android:textSize="22sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btn_student_change_email"
                            style="@style/Widget.FoodHero.Button.Text" android:layout_width="wrap_content"
                            android:layout_height="48dp" android:text="Change email" />
                        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btn_student_resend_code"
                            style="@style/Widget.FoodHero.Button.Text" android:layout_width="wrap_content"
                            android:layout_height="48dp" android:enabled="false" android:text="Resend in 60s" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout android:id="@+id/step_student_success" android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"
            android:padding="32dp" android:visibility="gone">
            <TextView android:layout_width="72dp" android:layout_height="72dp" android:gravity="center"
                android:background="@drawable/bg_circle_container" android:text="✓" android:textColor="@color/colorPrimary"
                android:textSize="36sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:fontFamily="@font/roboto_slab"
                android:text="Student access activated" android:textColor="@color/colorTextPrimary"
                android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_student_success_summary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center"
                android:textColor="@color/colorTextSecondary" android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/colorSurface" android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="20dp" android:paddingTop="12dp" android:paddingEnd="20dp" android:paddingBottom="16dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_student_signup_back"
            style="@style/Widget.FoodHero.Button.Secondary" android:layout_width="wrap_content"
            android:layout_height="48dp" android:text="Cancel" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ProgressBar android:id="@+id/progress_student_signup" android:layout_width="32dp"
            android:layout_height="32dp" android:layout_marginEnd="12dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_student_signup_primary"
            style="@style/Widget.FoodHero.Button.Primary" android:layout_width="wrap_content"
            android:layout_height="48dp" android:minWidth="128dp" android:text="Send code" />
    </LinearLayout>
</LinearLayout>
