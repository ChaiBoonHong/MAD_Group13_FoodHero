<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_24"
    android:paddingTop="@dimen/spacing_16"
    android:paddingEnd="@dimen/spacing_24"
    android:paddingBottom="@dimen/spacing_16">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="If the student's phone screen is cracked or the camera cannot scan, type the 6-character code or token displayed on the student's order screen:"
        android:textColor="@color/colorTextSecondary"
        android:textSize="@dimen/text_size_sub" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.FoodHero.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_manual_pickup_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:hint="e.g. FH-829104"
            android:inputType="textCapCharacters"
            android:maxLength="24"
            android:textSize="20sp"
            android:textStyle="bold" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:text="Verification ensures single-use redemption and awards 10 Eco-Points to the student."
        android:textColor="@color/colorPrimary"
        android:textSize="12sp" />
</LinearLayout>
