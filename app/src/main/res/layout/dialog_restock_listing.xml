<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_24"
    android:paddingTop="@dimen/spacing_16"
    android:paddingEnd="@dimen/spacing_24"
    android:paddingBottom="@dimen/spacing_16">

    <TextView
        android:id="@+id/tv_restock_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Surplus Bento Mystery Bag"
        android:textColor="@color/colorTextPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_restock_current_stock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Current stock: 0 remaining"
        android:textColor="@color/colorTextSecondary"
        android:textSize="@dimen/text_size_caption" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:text="@string/dialog_restock_prompt"
        android:textColor="@color/colorTextPrimary"
        android:textSize="@dimen/text_size_body" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.FoodHero.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_additional_quantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:hint="e.g. 5"
            android:inputType="number"
            android:maxLength="3"
            android:text="5"
            android:textSize="22sp"
            android:textStyle="bold" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:text="Restocking this bag will make it ACTIVE and visible on the student feed immediately."
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp" />
</LinearLayout>
