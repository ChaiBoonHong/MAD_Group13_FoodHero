<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Fullscreen Google Map View -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Floating Mode Selector & Route Info Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <!-- Travel Mode Selector Chips -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FoodHero.Card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:cardBackgroundColor="@color/colorSurface"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_travel_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/spacing_4"
                android:paddingEnd="@dimen/spacing_4"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_mode_walk"
                    style="@style/Widget.FoodHero.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/mode_walking"
                    app:chipIcon="@drawable/ic_walk" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_mode_bike"
                    style="@style/Widget.FoodHero.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_cycling"
                    app:chipIcon="@drawable/ic_bike" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_mode_shuttle"
                    style="@style/Widget.FoodHero.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_shuttle"
                    app:chipIcon="@drawable/ic_shuttle" />
            </com.google.android.material.chip.ChipGroup>
        </com.google.android.material.card.MaterialCardView>

        <!-- Route Info / Outside Campus Warning Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_route_info"
            style="@style/Widget.FoodHero.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:visibility="gone"
            app:cardBackgroundColor="@color/colorPrimaryContainer"
            app:cardElevation="4dp"
            app:strokeColor="@color/colorPrimary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_route_mode_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_walk"
                        app:tint="@color/colorPrimary" />

                    <TextView
                        android:id="@+id/tv_route_distance_eta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_8"
                        android:layout_weight="1"
                        android:text="350m • ~4 mins walk"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="@dimen/text_size_action"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_entrance_fallback_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:text="@string/outside_campus_warning"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Bottom Deal Preview Card (Slides up on marker click) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_deal_preview"
        style="@style/Widget.FoodHero.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/spacing_16"
        android:visibility="gone"
        app:cardBackgroundColor="@color/colorSurface"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_12">

            <ImageView
                android:id="@+id/iv_preview_image"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_food_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_preview_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Surplus Bento Mystery Bag"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="@dimen/text_size_action"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_preview_merchant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_2"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Grand Green Cafe • Pavilion I"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/text_size_caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_preview_price"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="RM 5.50"
                        android:textColor="@color/colorAccent"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_preview_view_deal"
                        style="@style/Widget.FoodHero.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/view_deal"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
