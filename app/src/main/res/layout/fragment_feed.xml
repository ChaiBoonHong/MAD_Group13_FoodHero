<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorBackground"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_16"
            android:paddingTop="@dimen/spacing_12"
            android:paddingEnd="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_8">

            <!-- Modern Search Bar (Pill with crisp border) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_search_bar">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_16"
                    android:paddingEnd="@dimen/spacing_12">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="@color/colorTextSecondary" />

                    <EditText
                        android:id="@+id/et_search_feed"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/spacing_10"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:textColor="@color/colorTextPrimary"
                        android:textColorHint="@color/colorTextTertiary"
                        android:textSize="@dimen/text_size_body" />

                    <ImageView
                        android:id="@+id/btn_clear_search"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Clear search"
                        android:padding="4dp"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:tint="@color/colorTextSecondary" />
                </LinearLayout>
            </FrameLayout>

            <!-- Horizontal Category / Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_10"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_categories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_all"
                        style="@style/Widget.FoodHero.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/filter_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_under_5"
                        style="@style/Widget.FoodHero.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_under_5" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_meals"
                        style="@style/Widget.FoodHero.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_rice_noodle" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_bakery"
                        style="@style/Widget.FoodHero.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_bakery" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_veg"
                        style="@style/Widget.FoodHero.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_veg" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_feed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Listing Cards RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_feed_listings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/spacing_16" />

            <!-- Empty State -->
            <include
                android:id="@+id/layout_empty"
                layout="@layout/layout_empty_state" />

            <!-- Error State -->
            <include
                android:id="@+id/layout_error"
                layout="@layout/layout_error_state" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
