<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_16"
        android:paddingTop="@dimen/spacing_12"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingBottom="@dimen/spacing_8">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/merchant_listings_title"
                android:textColor="@color/colorTextPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_merchant_listings_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Showing active &amp; surplus bags"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_listing_header"
            style="@style/Widget.FoodHero.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="+ New Bag"
            android:textSize="13sp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconSize="16dp" />
    </LinearLayout>

    <!-- Horizontal Status Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingBottom="@dimen/spacing_8"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status_all"
                style="@style/Widget.FoodHero.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/filter_status_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status_active"
                style="@style/Widget.FoodHero.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_status_active" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status_low_stock"
                style="@style/Widget.FoodHero.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_status_low_stock" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status_expired"
                style="@style/Widget.FoodHero.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_status_expired" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Listings SwipeRefresh & RecyclerView -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_merchant_listings"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_merchant_listings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/spacing_24" />

            <!-- Empty State View -->
            <include
                android:id="@+id/layout_empty_listings"
                layout="@layout/layout_empty_state"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
