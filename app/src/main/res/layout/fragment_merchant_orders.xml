<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <!-- Top Action Banner: Scan QR & Enter Code -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        android:elevation="1dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_12">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_scan_qr_action"
            style="@style/Widget.FoodHero.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="@dimen/spacing_6"
            android:layout_weight="1"
            android:text="@string/btn_scan_qr"
            android:textSize="13sp"
            app:icon="@drawable/ic_qr_scanner"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_enter_code_action"
            style="@style/Widget.FoodHero.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="@dimen/spacing_6"
            android:layout_weight="1"
            android:text="@string/btn_enter_code"
            android:textSize="13sp"
            app:icon="@drawable/ic_qr_code"
            app:iconGravity="textStart" />
    </LinearLayout>

    <!-- Order Status Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout_merchant_orders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        app:tabIndicatorColor="@color/colorPrimary"
        app:tabIndicatorHeight="3dp"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="@color/colorPrimary"
        app:tabTextColor="@color/colorTextSecondary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reserved / Ready" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Completed" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancelled / Expired" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Orders List SwipeRefresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_merchant_orders"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_merchant_orders"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="@dimen/spacing_8"
                android:paddingBottom="@dimen/spacing_24" />

            <include
                android:id="@+id/layout_empty_merchant_orders"
                layout="@layout/layout_empty_state"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
