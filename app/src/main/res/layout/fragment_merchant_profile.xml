<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_16"
        android:paddingTop="@dimen/spacing_12"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingBottom="@dimen/spacing_32">

        <!-- Outlet Profile Header Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FoodHero.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorPrimaryDark"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_20">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Avatar / Icon Container -->
                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_circle_container"
                        android:backgroundTint="@color/colorPrimary">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:contentDescription="Store Logo"
                            android:src="@drawable/ic_foodhero_logo" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_profile_business_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Merchant Store"
                            tools:text="Grand Green Cafe"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_profile_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="UTAR Kampar Campus"
                            tools:text="Student Pavilion I, Cafeteria Stn 3"
                            android:textColor="#B2DFDB"
                            android:textSize="@dimen/text_size_sub" />

                        <!-- Verified Badge -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/verified_merchant_badge"
                            android:textColor="@color/colorAccent"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Description & Contact -->
                <TextView
                    android:id="@+id/tv_profile_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Stall description"
                    tools:text="Serving fresh and affordable campus meals daily."
                    android:textColor="#E0F2F1"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_profile_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="+60 12-345 6789"
                    tools:text="+60 12-345 6789"
                    android:textColor="#B2DFDB"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:layout_marginBottom="@dimen/spacing_12"
                    android:background="#2E6B47" />

                <!-- Operating Info & Edit Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/operating_hours"
                            android:textColor="#B2DFDB"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_profile_operating_hours"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/operating_hours_val"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_edit_profile"
                        style="@style/Widget.FoodHero.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:backgroundTint="@color/scrim_dark"
                        android:text="Edit Details"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        app:strokeColor="@color/white" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- DuitNow Payment & QR Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FoodHero.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/colorPrimaryContainer"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="DuitNow QR"
                        android:src="@drawable/ic_qr_code"
                        app:tint="@color/colorPrimary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_8"
                        android:layout_weight="1"
                        android:text="DuitNow QR Payment"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_profile_duitnow_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="@color/colorPrimaryContainer"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="Active"
                        android:textColor="@color/colorPrimary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Students scan this verified DuitNow QR to pay for their orders."
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="12sp" />

                <!-- DuitNow Account Name Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/colorBackground"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Payee / Account Name"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_profile_duitnow_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="-"
                        tools:text="Grand Green Cafe"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- DuitNow QR Image Frame -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/white"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/iv_profile_duitnow_qr"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:contentDescription="Store DuitNow QR Code"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_qr_code" />

                    <ProgressBar
                        android:id="@+id/progress_profile_qr"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_profile_qr_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Verified Merchant QR"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="12sp" />

                <!-- Action Button to Update QR -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_duitnow_qr"
                    style="@style/Widget.FoodHero.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:text="Update DuitNow QR &amp; Details"
                    app:icon="@drawable/ic_qr_code"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Rating Overview Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FoodHero.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_16">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/spacing_16">

                    <TextView
                        android:id="@+id/tv_profile_avg_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="-"
                        tools:text="4.9"
                        android:textColor="@color/colorLevelBadgeGold"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="Star"
                            android:src="@drawable/ic_star"
                            app:tint="@color/colorLevelBadgeGold" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="Star"
                            android:src="@drawable/ic_star"
                            app:tint="@color/colorLevelBadgeGold" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="Star"
                            android:src="@drawable/ic_star"
                            app:tint="@color/colorLevelBadgeGold" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="Star"
                            android:src="@drawable/ic_star"
                            app:tint="@color/colorLevelBadgeGold" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="Star"
                            android:src="@drawable/ic_star"
                            app:tint="@color/colorLevelBadgeGold" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="50dp"
                    android:background="@color/colorDivider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_16"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Community Rating"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_profile_review_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="No reviews yet from student pickups"
                        tools:text="Based on 28 verified student pickups"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12sp" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Customer Reviews Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:layout_marginBottom="@dimen/spacing_8"
            android:text="@string/customer_reviews_title"
            android:textColor="@color/colorTextPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Reviews RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_merchant_reviews"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/tv_no_reviews"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/spacing_20"
            android:text="@string/no_reviews_yet"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Account Section & Logout -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_switch_to_student"
            style="@style/Widget.FoodHero.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/spacing_24"
            android:enabled="false"
            android:text="Checking account access…" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_merchant_logout"
            style="@style/Widget.FoodHero.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="@string/logout"
            android:textColor="@color/colorError"
            android:textSize="14sp"
            app:strokeColor="@color/colorError" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
