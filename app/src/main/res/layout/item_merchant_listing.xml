<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.FoodHero.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_16"
    android:layout_marginTop="@dimen/spacing_6"
    android:layout_marginEnd="@dimen/spacing_16"
    android:layout_marginBottom="@dimen/spacing_6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Image with Category & Status Overlay -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp">

            <ImageView
                android:id="@+id/iv_merchant_listing_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Listing Photo"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_food_placeholder" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gradient_scrim_bottom" />

            <!-- Category Badge (Top Start) -->
            <TextView
                android:id="@+id/tv_merchant_listing_category"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_gravity="start|top"
                android:layout_margin="@dimen/spacing_10"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/scrim_dark"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_10"
                android:text="Meals"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Status Pill (Top End) -->
            <TextView
                android:id="@+id/tv_merchant_listing_status"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_gravity="end|top"
                android:layout_margin="@dimen/spacing_10"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/colorSuccess"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_10"
                android:text="ACTIVE"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Stock Count (Bottom Start) -->
            <TextView
                android:id="@+id/tv_merchant_listing_stock_pill"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_gravity="start|bottom"
                android:layout_margin="@dimen/spacing_10"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/scrim_dark"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_10"
                android:text="4 / 5 Remaining"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Listing Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_14">

            <TextView
                android:id="@+id/tv_merchant_listing_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Surplus Bento Mystery Bag"
                android:textColor="@color/colorTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Pickup Window & Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Pickup Clock"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/colorTextSecondary" />

                <TextView
                    android:id="@+id/tv_merchant_listing_pickup_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Pickup: 16:30 - 18:00"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_merchant_listing_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="• Student Pavilion I"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Price Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_10"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_merchant_listing_discount_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="RM 5.50"
                    android:textColor="@color/colorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_merchant_listing_original_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:fontFamily="monospace"
                    android:text="RM 12.50"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_merchant_listing_co2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.8 kg CO₂"
                    android:textColor="@color/colorSuccess"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_12"
                android:layout_marginBottom="@dimen/spacing_10"
                android:background="@color/colorDivider" />

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_listing"
                    style="@style/Widget.FoodHero.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="@dimen/spacing_6"
                    android:layout_weight="1"
                    android:text="@string/btn_edit"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_restock_listing"
                    style="@style/Widget.FoodHero.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="@dimen/spacing_4"
                    android:layout_weight="1"
                    android:text="@string/btn_restock"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_deactivate_listing"
                    style="@style/Widget.FoodHero.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="@dimen/spacing_6"
                    android:layout_weight="1"
                    android:text="@string/btn_deactivate"
                    android:textColor="@color/colorError"
                    android:textSize="12sp"
                    app:strokeColor="@color/colorError" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
