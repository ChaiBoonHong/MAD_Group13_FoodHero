<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/top_app_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:background="@color/colorSurface"
    android:paddingStart="@dimen/spacing_16"
    android:paddingTop="@dimen/spacing_10"
    android:paddingEnd="@dimen/spacing_16"
    android:paddingBottom="@dimen/spacing_10">

    <!-- Campus / Brand Header -->
    <LinearLayout
        android:id="@+id/ll_brand"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/fl_notification_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_slab"
            android:text="@string/app_name"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Campus Dropdown Pill -->
        <LinearLayout
            android:id="@+id/layout_campus_dropdown"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/spacing_12"
            android:background="@drawable/bg_pill_chip_inactive"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_10"
            android:paddingEnd="@dimen/spacing_8">

            <TextView
                android:id="@+id/tv_campus_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UTAR Kampar Campus"
                android:textColor="@color/colorTextPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/colorTextSecondary"
                android:contentDescription="Select campus" />
        </LinearLayout>
    </LinearLayout>

    <!-- Notification Bell with Unread Badge in Light Circular Container -->
    <FrameLayout
        android:id="@+id/fl_notification_container"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_circle_container"
        android:backgroundTint="@color/colorSurfaceVariant"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_notification_bell"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@string/notifications"
            android:src="@drawable/ic_notifications"
            app:tint="@color/colorTextPrimary" />

        <TextView
            android:id="@+id/tv_notification_badge_count"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_circle_container"
            android:backgroundTint="@color/colorAccent"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="visible" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
