<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Splash Theme -->
    <style name="Theme.FoodHero.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/colorPrimaryDark</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>

    <!-- Buttons: Bento 12dp Corner Radius & Standard Heights -->
    <style name="Widget.FoodHero.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/corner_button</item>
        <item name="android:minHeight">@dimen/button_height_primary</item>
        <item name="android:textSize">@dimen/text_size_action</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="elevation">@dimen/elevation_card</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.FoodHero.Button.Accent" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorAccent</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/corner_button</item>
        <item name="android:minHeight">@dimen/button_height_primary</item>
        <item name="android:textSize">@dimen/text_size_action</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="elevation">@dimen/elevation_card</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.FoodHero.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="cornerRadius">@dimen/corner_button</item>
        <item name="android:minHeight">@dimen/button_height_primary</item>
        <item name="android:textSize">@dimen/text_size_action</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.FoodHero.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Cards: Modern Clean Bento Grid Cards (Zero Shadow, Crisp 1px Stroke) -->
    <style name="Widget.FoodHero.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/corner_card</item>
        <item name="cardElevation">0dp</item>
        <item name="cardMaxElevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="cardPreventCornerOverlap">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="strokeColor">@color/colorCardBorder</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <style name="Widget.FoodHero.Card.Flat" parent="Widget.FoodHero.Card">
        <item name="cardElevation">0dp</item>
        <item name="cardMaxElevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="cardPreventCornerOverlap">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="strokeColor">@color/colorDivider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.FoodHero.Card.Impact" parent="Widget.FoodHero.Card">
        <item name="cardBackgroundColor">@color/colorPrimaryContainer</item>
        <item name="cardElevation">0dp</item>
        <item name="cardMaxElevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="cardPreventCornerOverlap">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.FoodHero.Card.Metric" parent="Widget.FoodHero.Card">
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="cardElevation">0dp</item>
        <item name="cardMaxElevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="cardPreventCornerOverlap">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="strokeColor">@color/colorDivider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Text Input Layouts (Modern 12dp Box Corner Radius) -->
    <style name="Widget.FoodHero.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_input</item>
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/colorPrimary</item>
        <item name="android:textColorHint">@color/colorTextSecondary</item>
    </style>

    <!-- Filter Chips (Modern Full-Pill) -->
    <style name="Widget.FoodHero.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipCornerRadius">@dimen/corner_pill</item>
        <item name="chipBackgroundColor">@color/colorSurface</item>
        <item name="chipStrokeColor">@color/colorDivider</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">@dimen/text_size_sub</item>
        <item name="android:minHeight">36dp</item>
    </style>

    <!-- Bottom Navigation Text Appearances -->
    <style name="TextAppearance.FoodHero.BottomNav.Active" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorPrimaryDark</item>
    </style>

    <style name="TextAppearance.FoodHero.BottomNav.Inactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
    </style>

    <!-- Material 3 Active Indicator Style (Pill) -->
    <style name="Widget.FoodHero.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/colorPrimaryContainer</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
    </style>

    <!-- Material 3 Bottom Navigation View with Pill Indicator -->
    <style name="Widget.FoodHero.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/colorSurface</item>
        <item name="backgroundTint">@color/colorSurface</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.FoodHero.BottomNavigation.ActiveIndicator</item>
        <item name="itemIconTint">@color/color_bottom_nav_icon</item>
        <item name="itemTextColor">@color/color_bottom_nav_text</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.FoodHero.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.FoodHero.BottomNav.Inactive</item>
        <item name="elevation">0dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
    </style>
</resources>
