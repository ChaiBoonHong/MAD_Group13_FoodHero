<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Splash Theme -->
    <style name="Theme.FoodHero.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/colorPrimaryDark</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.FoodHero.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/corner_button</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:textSize">@dimen/text_size_action</item>
        <item name="android:textStyle">bold</item>
        <item name="elevation">2dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.FoodHero.Button.Accent" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorAccent</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/corner_button</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:textSize">@dimen/text_size_action</item>
        <item name="android:textStyle">bold</item>
        <item name="elevation">2dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.FoodHero.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="cornerRadius">@dimen/corner_button</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:textSize">@dimen/text_size_action</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.FoodHero.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Cards -->
    <style name="Widget.FoodHero.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/corner_card</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="cardMaxElevation">@dimen/elevation_card_elevated</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <style name="Widget.FoodHero.Card.Impact" parent="Widget.FoodHero.Card">
        <item name="cardBackgroundColor">@color/colorPrimaryContainer</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.FoodHero.Card.Metric" parent="Widget.FoodHero.Card">
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="strokeColor">@color/colorDivider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Text Input Layouts -->
    <style name="Widget.FoodHero.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_button</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_button</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_button</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_button</item>
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="hintTextColor">@color/colorPrimary</item>
        <item name="android:textColorHint">@color/colorTextSecondary</item>
    </style>

    <!-- Filter Chips -->
    <style name="Widget.FoodHero.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipCornerRadius">@dimen/corner_chip</item>
        <item name="chipBackgroundColor">@color/colorSurface</item>
        <item name="chipStrokeColor">@color/colorDivider</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">@dimen/text_size_body</item>
    </style>

    <!-- Status Chip -->
    <style name="Widget.FoodHero.StatusBadge" parent="">
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/spacing_8</item>
        <item name="android:paddingEnd">@dimen/spacing_8</item>
        <item name="android:paddingTop">@dimen/spacing_4</item>
        <item name="android:paddingBottom">@dimen/spacing_4</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Bottom Navigation View -->
    <style name="Widget.FoodHero.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/colorSurface</item>
        <item name="itemIconTint">@color/colorPrimary</item>
        <item name="itemTextColor">@color/colorPrimary</item>
        <item name="elevation">8dp</item>
    </style>
</resources>
